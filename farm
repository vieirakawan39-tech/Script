local function visitLocal(coordList, locationName)
    if #coordList == 0 then return 0 end
    if labels.status then labels.status.Text = "TP "..locationName.." 1/"..#coordList end
    TpFreeze(coordList[1])
    if stopReq or died then return 0 end
    task.wait(0.3)
    local ch = player.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or coordList[1]
    local checkPrompts = findPromptsNear(myPos, VERIFY_RADIUS)
    if #checkPrompts == 0 then
        if labels.status then labels.status.Text = locationName.." VAZIO" end
        if labels.promptCount then labels.promptCount.Text = "0" end
        return 0
    end
    local totalCollected = 0
    for idx, coord in ipairs(coordList) do
        if stopReq or died then break end
        if not isAlive() then died = true; break end
        if labels.status then
            labels.status.Text = string.format("%s %d/%d", locationName, idx, #coordList)
        end
        if labels.coord then
            labels.coord.Text = string.format("%.1f, %.1f, %.1f", coord.X, coord.Y, coord.Z)
        end
        TpFreeze(coord)
        if stopReq or died then break end
        task.wait(0.15)
        local ch2 = player.Character
        local hrp2 = ch2 and ch2:FindFirstChild("HumanoidRootPart")
        local myPos2 = hrp2 and hrp2.Position or coord
        local prompts = findPromptsNear(myPos2, SCAN_RADIUS)
        if #prompts > 0 then
            if labels.promptCount then labels.promptCount.Text = tostring(#prompts) end
            for i, item in ipairs(prompts) do
                if stopReq or died then break end
                if labels.prompt then
                    labels.prompt.Text = string.format("%d/%d", i, #prompts)
                end
                local targetPos = item.pos + Vector3.new(0, 2, 0)
                TpFreeze(targetPos)
                if stopReq or died then break end
                task.wait(0.1)
                local hit = autoHold(item.prompt)
                if stopReq or died then break end
                if hit then
                    totalCollected = totalCollected + 1
                    if labels.collected then
                        local cur = tonumber(labels.collected.Text) or 0
                        labels.collected.Text = tostring(cur + 1)
                    end
                    if i < #prompts then task.wait(0.3) end
                end
            end
        else
            if labels.promptCount then labels.promptCount.Text = "0" end
            if labels.prompt then labels.prompt.Text = "-" end
        end
        if totalCollected > 0 then coolD(1) end
    end
    return totalCollected
end

local function startAuto()
    if running then return end
    stopReq = false
    cancelled = false
    died = false
    running = true
    bindDeath()
    if GHOST_ENABLED then startGhost() end
    local loopCount = 0
    local emptyStart = tick()
    while running and not stopReq and not died do
        if not isAlive() then died = true; break end
        loopCount = loopCount + 1
        if labels.loopCount then labels.loopCount.Text = tostring(loopCount) end
        local pol = countPolice()
        if labels.police then labels.police.Text = tostring(pol).." / "..MIN_POLICE end
        if pol < MIN_POLICE then
            if labels.status then
                labels.status.Text = string.format("POLICE %d/%d -> HOP", pol, MIN_POLICE)
            end
            running = false
            serverHop("SEM POLICIA")
            return
        end
        local c1 = visitLocal(CASSINO_COORDS, "CASSINO")
        if stopReq or died then break end
        local c2 = visitLocal(CENTRAL_COORDS, "CENTRAL")
        if stopReq or died then break end
        if c1 == 0 and c2 == 0 then
            local el = tick() - emptyStart
            if labels.status then
                labels.status.Text = string.format("VAZIO (%ds)", math.floor(el))
            end
            if el >= HOP_EMPTY_TIME then
                running = false
                serverHop("VAZIO")
                return
            end
            task.wait(1)
        else
            emptyStart = tick()
            if labels.status then
                labels.status.Text = string.format("CASS=%d CENT=%d", c1, c2)
            end
            coolD(COOLDOWN)
        end
    end
    running = false
    if labels.freeze then labels.freeze.Text = "OFF" end
    if player.Character then
        local h = player.Character:FindFirstChild("HumanoidRootPart")
        if h then pcall(function() h.Anchored = false end) end
    end
    if not stopReq then
        if died then serverHop("MORREU"); return end
    end
end

local function stopAuto()
    stopReq = true
    cancelled = true
    running = false
    stopGhost()
    if player.Character then
        local h = player.Character:FindFirstChild("HumanoidRootPart")
        if h then pcall(function() h.Anchored = false end) end
    end
    if labels.status then labels.status.Text = "STOPPED" end
    if labels.freeze then labels.freeze.Text = "OFF" end
end

