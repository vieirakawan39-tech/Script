local function wm(s, list)
    if not s then return false end
    s = string.lower(s)
    for _, w in ipairs(list) do
        if s:find(w, 1, true) then return true end
    end
    return false
end

local function isPolice(p)
    if not p then return false end
    if p.Team and wm(p.Team.Name, PW_TEAM) then return true end
    if p.Team then
        local tc = p.Team.TeamColor.Color
        if tc.R < 0.3 and tc.G < 0.55 and tc.B > 0.55 then return true end
    end
    if wm(p.Name, PW_TEAM) or wm(p.DisplayName, PW_TEAM) then return true end
    local ok, attrs = pcall(function() return p:GetAttributes() end)
    if ok and attrs then
        for k, v in pairs(attrs) do
            if wm(k, PW_TEAM) then
                if typeof(v) == "boolean" and v then return true end
                if typeof(v) == "number" and v > 0 then return true end
                if typeof(v) == "string" and wm(v, PW_TEAM) then return true end
            end
            if typeof(v) == "string" and wm(v, PW_TEAM) then return true end
        end
    end
    local leaderstats = p:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if wm(stat.Name, PW_TEAM) then return true end
            if stat:IsA("StringValue") and wm(stat.Value, PW_TEAM) then return true end
        end
    end
    if p.Character then
        local ok2, cAttrs = pcall(function() return p.Character:GetAttributes() end)
        if ok2 and cAttrs then
            for k, v in pairs(cAttrs) do
                if wm(k, PW_TEAM) then return true end
                if typeof(v) == "string" and wm(v, PW_TEAM) then return true end
            end
        end
        local hu = p.Character:FindFirstChildOfClass("Humanoid")
        if hu and wm(hu.DisplayName, PW_TEAM) then return true end
    end
    local srcs = {p:FindFirstChild("Backpack")}
    if p.Character then table.insert(srcs, p.Character) end
    for _, src in ipairs(srcs) do
        if src then
            for _, it in ipairs(src:GetChildren()) do
                if wm(it.Name, PW_TOOL) then return true end
            end
        end
    end
    return false
end

